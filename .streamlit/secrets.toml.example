# Copy to .streamlit/secrets.toml (git-ignored). Her email is typed in the app, so it isn't here.
[picnic]
his_email = "you@gmail.com"      # you: gets a copy of what she picked

# Confirmation emails (required for them to send). Use a Gmail "app password":
# Google account > Security > 2-Step Verification > App passwords.
[email]
username = "you@gmail.com"
app_password = "xxxx xxxx xxxx xxxx"

# Optional: also create a Google Calendar event with a Meet link (run `python setup_google.py client_secret.json`).
[google]
client_id = ""
client_secret = ""
refresh_token = ""
